# --- Database ---
# Local dev: postgresql+asyncpg://localhost:5432/bput_career
# Production: your hosted Postgres URL, e.g. postgresql+asyncpg://user:pass@host:5432/dbname
DATABASE_URL=postgresql+asyncpg://localhost:5432/bput_career

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- OAuth 2.0 ---
# Authorized redirect URIs to register with each provider:
#   Google → {BACKEND_BASE_URL}/api/auth/oauth/google/callback
#   GitHub → {BACKEND_BASE_URL}/api/auth/oauth/github/callback
# Leave a pair blank and that button simply doesn't render.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- AI ---
# Which provider the AI layer calls. "ollama" for local dev (free, offline),
# "groq" in deployment — Render cannot reach the Ollama on your laptop.
LLM_PROVIDER=ollama

# Local dev (LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Deployment (LLM_PROVIDER=groq) — free key from https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- File storage (optional) ---
CLOUDINARY_URL=

# --- Sign-up verification ---
# Students must register with an email on this domain.
STUDENT_EMAIL_DOMAIN=bput.ac.in
# Recruiters are blocked from registering with these free/consumer email domains.
RECRUITER_BLOCKED_DOMAINS=gmail.com,yahoo.com,outlook.com,hotmail.com,icloud.com,protonmail.com,aol.com
VERIFICATION_CODE_EXPIRE_MINUTES=15

# --- SMTP (sends the email verification code) ---
# Leave SMTP_HOST empty for local dev: codes print to the backend console instead
# of being emailed, so you can still test registration without mail credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@bput-career.local
SMTP_USE_TLS=true

# --- Public URLs (used to build OAuth redirect URIs) ---
# In deployment these become your Render and Vercel HTTPS URLs.
BACKEND_BASE_URL=http://127.0.0.1:8000
FRONTEND_BASE_URL=http://localhost:5173

# --- CORS ---
# Comma-separated allowed origins; empty falls back to local Vite dev ports
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
